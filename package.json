{
  "name": "naukri-portal",
  "version": "1.0.0",
  "description": "Government job alert portal with admin panel and hourly auto-import of job facts",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "import:now": "node src/scraper/cli.js",
    "seed": "node src/seed.js",
    "seed:jobs": "node src/seed-jobs.js",
    "import:excel": "node src/excel-import.js",
    "export:preview": "node scripts/export-preview.js",
    "test": "node test/run.js && node test/social.js && node test/api.js && node test/push.js"
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "better-sqlite3": "^11.7.0",
    "cheerio": "^1.0.0",
    "compression": "^1.7.5",
    "dotenv": "^16.4.7",
    "ejs": "^3.1.10",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "multer": "^2.5.0",
    "node-cron": "^3.0.3",
    "robots-parser": "^3.0.1",
    "sharp": "^0.33.5",
    "web-push": "^3.6.7"
  }
}
