<%- include('_top') %>
<h1>Settings</h1>
<% if (process.env.RENDER || process.env.RENDER_EXTERNAL_URL) { %><div class="flash">On Render's free plan, what you save here is wiped when the server restarts. After saving, open <a href="/admin/keep-settings"><strong>Keep settings</strong></a> and paste them into Render once.</div><% } %>
<form method="post" action="/admin/settings" class="pform">
  <section class="card">
    <h2>Site</h2>
    <div class="grid2">
      <label>Site name<input name="site_name" value="<%= s.site_name %>"></label>
      <label>Tagline<input name="site_tagline" value="<%= s.site_tagline %>"></label>
    </div>
    <label>Home page intro (also the home meta description)<textarea name="home_intro" rows="2"><%= s.home_intro %></textarea></label>
    <div class="grid3">
      <label>Telegram channel URL<input name="telegram_url" value="<%= s.telegram_url %>"></label>
      <label>WhatsApp channel URL<input name="whatsapp_url" value="<%= s.whatsapp_url %>"></label>
      <label>Contact e-mail<input name="contact_email" value="<%= s.contact_email %>"></label>
    </div>
  </section>
  <section class="card">
    <h2>News</h2>
    <label class="check"><input type="checkbox" name="auto_news" value="1" <%= s.auto_news !== '0' ? 'checked' : '' %>> Write a Hindi news story automatically for every published update (shown in the News section and on the home page). Stories you edit by hand are never overwritten.</label>
    <h2>Auto-import</h2>
    <label class="check"><input type="checkbox" name="auto_publish" value="1" <%= s.auto_publish === '1' ? 'checked' : '' %>> Publish imported posts automatically (posts with too little detail always stay as drafts)</label>
    <div class="grid2">
      <label>Max new posts per source per run<input name="max_per_run" type="number" min="1" max="50" value="<%= s.max_per_run %>"></label>
      <label>Pages to import on a source's first check<input name="first_run_limit" type="number" min="0" max="50" value="<%= s.first_run_limit %>"></label>
    </div>
  </section>
  <section class="card">
    <h2>SEO &amp; monetisation</h2>
    <div class="grid3">
      <label>Google Search Console verification code<input name="google_verification" value="<%= s.google_verification %>"></label>
      <label>Google Analytics ID (G-…)<input name="ga_id" value="<%= s.ga_id %>"></label>
      <label>AdSense client (ca-pub-…)<input name="adsense_client" value="<%= s.adsense_client %>"></label>
    </div>
  </section>
  <button class="btn">Save settings</button>
</form>

<section class="card" id="banner-photos">
  <h2>Banner photo</h2>
  <p class="muted">The person on the right of every post's banner. Without a photo, the drawn student is used.</p>
  <% if (sample) { %><p><a href="/banner/<%= sample.slug %>.jpg" target="_blank"><img src="/banner/<%= sample.slug %>.jpg?t=<%= Date.now() %>" alt="Banner preview" style="width:100%;max-width:640px;border-radius:10px;border:1px solid #dbe4e1"></a></p><% } %>
  <% if (people.length) { %>
    <div class="people-grid">
      <% people.forEach(p => { %>
        <figure><img src="/admin/banner-people/<%= encodeURIComponent(p.name) %>" alt="<%= p.name %>"><figcaption><%= p.name %><% if (p.uploaded) { %>
          <form method="post" action="/admin/banner-people/<%= encodeURIComponent(p.name) %>/delete" onsubmit="return confirm('Remove this photo?')"><button class="linkbtn danger">Remove</button></form><% } else { %> <span class="muted small">(in GitHub)</span><% } %></figcaption></figure>
      <% }) %>
    </div>
  <% } %>
  <form method="post" action="/admin/banner-people" enctype="multipart/form-data" class="pform">
    <div class="grid2">
      <label>Photo (PNG with transparent background is best)<input type="file" name="photo" accept="image/png,image/jpeg,image/webp" required></label>
      <label>Use for (optional) <input name="topic" placeholder="e.g. police, railway, teacher — blank = all posts"></label>
    </div>
    <button class="btn">Upload photo</button>
  </form>
  <details><summary>How to make a photo with free AI</summary>
    <ol class="steps-list">
      <li>Open <strong>ChatGPT</strong>, <strong>Google Gemini</strong> or <strong>Bing Image Creator</strong> and ask for, for example: <em>“Photorealistic young Indian woman in her early 20s, smiling confidently, teal kurta with a pink dupatta, ID card on a lanyard, holding books and a file, waist-up, facing the camera, plain white background, soft studio light.”</em></li>
      <li>Remove the background for a cut-out look (free at <strong>remove.bg</strong> or in Canva) and download it as <strong>PNG</strong>.</li>
      <li>Upload it here. On Render's free plan uploads are wiped on restart — to keep it for good, also add the file to your GitHub repo in <code>assets/banner-people/</code> (GitHub → Add file → Upload files).</li>
    </ol>
    <p class="muted small">Use pictures you made or have a licence for — never photos of real people copied from other websites.</p>
  </details>
</section>
<%- include('_bottom') %>
