<%- include('_top') %>
<h1>Posts</h1>

<nav class="tabs">
  <a class="<%= !filters.status ? 'on' : '' %>" href="?<%= qs({ status: '', page: '' }) %>">All <span><%= counts.all %></span></a>
  <a class="<%= filters.status === 'published' ? 'on' : '' %>" href="?<%= qs({ status: 'published', page: '' }) %>">Published <span><%= counts.published %></span></a>
  <a class="<%= filters.status === 'draft' ? 'on' : '' %>" href="?<%= qs({ status: 'draft', page: '' }) %>">Unpublished (drafts) <span><%= counts.draft %></span></a>
</nav>

<form class="row filters" method="get" id="filters">
  <% if (filters.status) { %><input type="hidden" name="status" value="<%= filters.status %>"><% } %>
  <select name="category" onchange="this.form.submit()"><option value="">All sections</option><% Object.entries(CATEGORIES).forEach(([k,c]) => { %><option value="<%= k %>" <%= filters.category===k?'selected':'' %>><%= c.name %></option><% }) %></select>
  <select name="source" onchange="this.form.submit()">
    <option value="">Any source</option>
    <option value="sheet" <%= filters.source==='sheet'?'selected':'' %>>Excel sheet / added by hand</option>
    <option value="auto" <%= filters.source==='auto'?'selected':'' %>>Auto-imported from sites</option>
  </select>
  <select name="issue" onchange="this.form.submit()">
    <option value="">Any content</option>
    <option value="empty" <%= filters.issue==='empty'?'selected':'' %>>Empty — no dates and no links</option>
    <option value="nodates" <%= filters.issue==='nodates'?'selected':'' %>>No dates</option>
    <option value="closed" <%= filters.issue==='closed'?'selected':'' %>>Jobs past last date</option>
  </select>
  <input name="q" value="<%= filters.q %>" placeholder="Search title or organisation">
  <button class="btn ghost">Search</button>
  <% if (filters.category || filters.source || filters.issue || filters.q) { %><a class="linkbtn" href="?<%= new URLSearchParams(filters.status ? { status: filters.status } : {}).toString() %>">Clear filters</a><% } %>
  <a class="btn" href="/admin/posts/new" style="margin-left:auto">+ New post</a>
</form>

<form method="post" action="/admin/posts/bulk" id="bulk">
  <input type="hidden" name="back" value="<%= qs({}) %><%= page > 1 ? '&page=' + page : '' %>">
  <% Object.entries(filters).forEach(([k, v]) => { %><input type="hidden" name="<%= k %>" value="<%= v %>"><% }) %>
  <input type="hidden" name="all" value="0" id="allMatching">

  <div class="bulkbar" id="bulkbar" hidden>
    <strong id="selCount">0 selected</strong>
    <span id="selAllWrap" hidden> · <button type="button" class="linkbtn" id="selAll">Select all <%= total %> matching posts</button></span>
    <span class="spacer"></span>
    <% if (can('posts.publish')) { %><button class="btn ghost" name="action" value="publish">Publish</button>
    <button class="btn ghost" name="action" value="draft">Unpublish</button><% } %>
    <% if (can('social.share')) { %><button class="btn ghost" name="action" value="share" title="Posts each one's news story with its image to your social accounts">Share to social</button><% } %>
    <% if (can('posts.delete')) { %><button class="btn danger" name="action" value="delete" onclick="return confirm(document.getElementById('selCount').textContent.replace('selected','') + ' will be moved to the recycle bin (restorable for 30 days). Continue?')">Delete</button><% } %>
  </div>

  <div class="card flush">
  <table>
    <thead><tr>
      <th class="ck"><input type="checkbox" id="checkAll" aria-label="Select all on this page"></th>
      <th>Title</th><th>Section</th><th>Status</th><th>Created</th><th></th>
    </tr></thead>
    <tbody>
    <% rows.forEach(p => { %>
      <tr>
        <td class="ck"><input type="checkbox" name="ids" value="<%= p.id %>" aria-label="Select"></td>
        <td>
          <a href="/admin/posts/<%= p.id %>"><%= p.title %></a>
          <div class="muted small">
            <%= p.source_url ? 'auto · ' + new URL(p.source_url).hostname : 'sheet / manual' %>
            <% if (p.empty) { %> · <span class="tag err">empty</span><% } %>
            <% if (p.category === 'latest-jobs' && p.last_date && p.last_date < today) { %> · <span class="tag err">closed</span><% } %>
          </div>
        </td>
        <td><%= CATEGORIES[p.category]?.short %></td>
        <td><span class="tag <%= p.status %>"><%= p.status === 'published' ? 'published' : 'unpublished' %></span></td>
        <td class="nowrap small"><%= p.created_at %></td>
        <td class="nowrap actions">
          <a href="<%= p.status === 'published' ? '/' + p.slug + '/' : '/admin/posts/' + p.id + '/preview' %>" target="_blank">View</a>
          <% if (can('posts.publish')) { %><button class="linkbtn" formaction="/admin/posts/<%= p.id %>/status?to=<%= p.status==='published'?'draft':'published' %>"><%= p.status==='published'?'Unpublish':'Publish' %></button><% } %>
          <% if (can('posts.delete')) { %><button class="linkbtn danger" formaction="/admin/posts/<%= p.id %>/delete" onclick="return confirm('Move this post to the recycle bin?')">Delete</button><% } %>
        </td>
      </tr>
    <% }) %>
    </tbody>
  </table>
  <% if (!rows.length) { %><p class="muted pad">No posts match these filters.</p><% } %>
  </div>
</form>

<% if (pages > 1) { %>
<p class="pager">
  <% if (page > 1) { %><a href="?<%= qs({ page: page - 1 }) %>">← Newer</a><% } %>
  <span class="muted">Page <%= page %> of <%= pages %> · <%= total %> posts</span>
  <% if (page < pages) { %><a href="?<%= qs({ page: page + 1 }) %>">Older →</a><% } %>
</p>
<% } %>

<script>
(() => {
  const boxes = [...document.querySelectorAll('input[name=ids]')];
  const all = document.getElementById('checkAll'), bar = document.getElementById('bulkbar'), count = document.getElementById('selCount');
  const allMatching = document.getElementById('allMatching'), selAllWrap = document.getElementById('selAllWrap');
  const total = <%= total %>;
  function update() {
    const n = boxes.filter(b => b.checked).length;
    bar.hidden = n === 0;
    if (allMatching.value === '1' && n === boxes.length) count.textContent = `All ${total} matching posts selected`;
    else { allMatching.value = '0'; count.textContent = `${n} selected`; }
    all.checked = n > 0 && n === boxes.length; all.indeterminate = n > 0 && n < boxes.length;
    selAllWrap.hidden = !(n === boxes.length && total > boxes.length && allMatching.value !== '1');
  }
  all.addEventListener('change', () => { boxes.forEach(b => (b.checked = all.checked)); allMatching.value = '0'; update(); });
  boxes.forEach(b => b.addEventListener('change', () => { allMatching.value = '0'; update(); }));
  document.getElementById('selAll').addEventListener('click', () => { allMatching.value = '1'; update(); });
  // shift-click to tick a range
  let last = null;
  boxes.forEach((b, i) => b.addEventListener('click', e => { if (e.shiftKey && last !== null) { const [a, z] = [Math.min(last, i), Math.max(last, i)]; for (let k = a; k <= z; k++) boxes[k].checked = b.checked; update(); } last = i; }));
})();
</script>
<%- include('_bottom') %>
