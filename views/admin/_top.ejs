<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex,nofollow"><title>Admin · <%= settings.site_name %></title>
<link rel="icon" href="/static/favicon.svg"><link rel="stylesheet" href="<%= asset('css/admin.css') %>"></head>
<body>
<header class="abar">
  <a class="logo" href="/admin"><%= settings.site_name %> <small>Admin</small></a>
  <nav>
    <% const L = [['/admin','Dashboard','posts.view'],['/admin/launch','Launch checklist','launch'],['/admin/posts','Posts','posts.view'],['/admin/posts/new','+ New post','posts.edit'],
      ['/admin/import','Import Excel','import'],['/admin/social','Social media','social.settings'],['/admin/notifications','Job alerts','notifications.settings'],['/admin/sources','Auto-import','sources'],
      ['/admin/settings','Settings','settings'],['/admin/trash','Recycle bin','trash'],['/admin/activity','Activity','activity'],['/admin/team','Team','users'],['/admin/api','API','api'],
      ['/admin/keep-settings','Keep settings','keep'],['/admin/logs','Logs','logs']];
      L.filter(([, , p]) => typeof can === 'undefined' || can(p)).forEach(([h, t]) => { %><a href="<%= h %>"><%= t %></a><% }) %>
    <a href="/" target="_blank">View site ↗</a>
    <% if (typeof user !== 'undefined' && user) { %><a class="who" href="/admin/account" title="My account"><%= user.username %> · <%= ROLES[user.role].name %></a><% } %>
    <form method="post" action="/admin/logout"><button class="linkbtn">Log out</button></form>
  </nav>
</header>
<main class="amain">
<% if (typeof msg !== 'undefined' && msg) { %><div class="flash"><%= msg %></div><% } %>
