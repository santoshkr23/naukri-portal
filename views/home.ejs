<%- include('partials/head') %>
<%- include('partials/header') %>
<section class="hero">
  <div class="wrap">
    <h1><%= settings.site_name %>: <%= settings.site_tagline %></h1>
    <p><%= settings.home_intro %></p>
    <% if (settings.telegram_url || settings.whatsapp_url) { %>
      <div class="cta-row">
        <% if (settings.whatsapp_url) { %><a class="pill wa" href="<%= settings.whatsapp_url %>" target="_blank" rel="noopener">Join WhatsApp</a><% } %>
        <% if (settings.telegram_url) { %><a class="pill tg" href="<%= settings.telegram_url %>" target="_blank" rel="noopener">Join Telegram</a><% } %>
      </div>
    <% } %>
  </div>
</section>

<% if (highlights.length) { %>
<section class="wrap tiles" aria-label="Top updates">
  <% highlights.forEach((h, i) => { %>
    <a class="tile t<%= i % 6 %>" href="/<%= h.slug %>/"><span><%= CATEGORIES[h.category]?.short %></span><%= h.title.split(/[:–]/)[0] %></a>
  <% }) %>
</section>
<% } %>

<% if (news.length) { const [lead, ...rest] = news; %>
<section class="wrap home-news" aria-label="Latest news">
  <div class="hn-head"><h2>ताज़ा खबरें <span>Latest News</span></h2><a href="/news/">सभी खबरें →</a></div>
  <div class="hn-grid">
    <a class="hn-lead" href="/<%= lead.slug %>/">
      <img src="/og/<%= lead.slug %>.png" alt="<%= lead.keyword %>" width="1200" height="630" loading="lazy">
      <strong><%= lead.title %></strong><time><%= timeAgo(lead.published_at) %></time>
    </a>
    <ul class="hn-list"><% rest.forEach(n => { %><li><a href="/<%= n.slug %>/"><img src="/og/<%= n.slug %>.png" alt="" width="120" height="63" loading="lazy"><span><%= n.title %><time><%= timeAgo(n.published_at) %></time></span></a></li><% }) %></ul>
  </div>
</section>
<% } %>

<section class="wrap boards">
  <% Object.entries(CATEGORIES).forEach(([k, c]) => { if (k === 'news' || (c.optional && !boxes[k].length)) return; %>
    <div class="board c-<%= c.color %>">
      <h2><a href="/<%= k %>/"><%= c.name %></a></h2>
      <% if (boxes[k].length) { %>
        <ul>
          <% boxes[k].forEach(p => { %>
            <li><a href="/<%= p.slug %>/"><%= p.title.split(/[:–]/)[0] %></a><% if (p.last_date && k === 'latest-jobs') { %> <em>Last date: <%= fmtDate(p.last_date) %></em><% } %></li>
          <% }) %>
        </ul>
        <a class="more" href="/<%= k %>/">View all <%= c.name.toLowerCase() %> →</a>
      <% } else { %><p class="empty">No updates yet.</p><% } %>
    </div>
  <% }) %>
</section>

<%- include('partials/home-seo') %>
<%- include('partials/footer') %>
