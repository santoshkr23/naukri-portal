# Public URL of your site (used in canonical tags, sitemap, schema)
BASE_URL=https://www.yourdomain.com
PORT=3000

# Admin login
ADMIN_USER=admin
ADMIN_PASSWORD=change-this-strong-password
SESSION_SECRET=put-a-long-random-string-here

# Where the SQLite database and generated images are stored (use a persistent disk in production)
DATA_DIR=./data

# Auto-import schedule (cron syntax). Default: every hour at minute 5
CRON_SCHEDULE=5 * * * *
# Set to 0 to switch off the scheduler (e.g. on a second server)
SCHEDULER_ENABLED=1

# Optional: IndexNow key — instantly notifies Bing/Yandex of new pages
INDEXNOW_KEY=

# Optional: AI rewrite of the intro text (writes from extracted facts only)
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-5-5
